# Set these in the Render Environment page or your shell.
# This example file is not automatically loaded by the Python server.
RETAIL_LLM_MODEL=qwen4-max
# Beijing legacy endpoint; copy the matching region endpoint from your console.
RETAIL_LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
RETAIL_LLM_API_KEY=
# Separate password chosen by the owner, NOT the model provider API key.
RETAIL_DEMO_ACCESS_CODE=
RETAIL_LLM_MAX_CALLS=20
RETAIL_LLM_MAX_OUTPUT_TOKENS=1800
